{
  "name": "ha-premium-video-downloader",
  "version": "1.0.1",
  "description": "A private, polished desktop interface for yt-dlp and ffmpeg.",
  "main": "./out/main/index.js",
  "author": "Hussain Ahmed",
  "homepage": "https://github.com/hussainislive/HA-VideoDownloader",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "predev": "npm run verify:binaries && npm run prepare:mac-runtime -- --optional",
    "build": "npm run typecheck && electron-vite build && npm run verify:bundle",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run verify:binaries",
    "test:e2e": "npm run build && playwright test --grep-invert \"@live|@performance\"",
    "pretest:e2e:live": "npm run verify:binaries",
    "test:e2e:live": "playwright test --grep @live",
    "test:e2e:performance": "npm run build && playwright test --grep @performance",
    "verify:binaries": "tsx scripts/verify-binaries.ts && npm run verify:icon",
    "verify:icon": "tsx scripts/verify-icon.ts",
    "verify:bundle": "tsx scripts/verify-renderer-bundle.ts",
    "prepare:mac-runtime": "tsx scripts/prepare-mac-runtime.ts",
    "verify:package:mac:x64": "tsx scripts/verify-package.ts --app \"release/mac/HA Premium Video Downloader.app\" --arch x64",
    "verify:package:mac:arm64": "tsx scripts/verify-package.ts --app \"release/mac-arm64/HA Premium Video Downloader.app\" --arch arm64",
    "smoke:package:mac:x64": "tsx scripts/smoke-mac-dmg.ts x64",
    "render:design": "tsx scripts/render-design.ts",
    "predist:mac": "npm run verify:binaries",
    "dist:mac": "npm run dist:mac:x64 && npm run dist:mac:arm64",
    "predist:mac:x64": "npm run verify:binaries && npm run prepare:mac-runtime",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64 && npm run verify:package:mac:x64",
    "predist:mac:arm64": "npm run verify:binaries && npm run prepare:mac-runtime",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64 && npm run verify:package:mac:arm64",
    "predist:win": "npm run verify:binaries",
    "dist:win": "npm run build && electron-builder --win --x64",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@tanstack/react-virtual": "3.14.13",
    "clsx": "2.1.1",
    "electron-log": "5.4.4",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.5.1",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  }
}
